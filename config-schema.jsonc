{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "config.schema.json",
    "title": "WDS Bridge Watchdog Configuration Schema",
    "description": "The Schema for the WDS Bridge Watchdog JSON Configuration File.",
    "markdownDescription": "The Schema for the `config.json` Configuration File for the *WDS Bridge Watchdog Service*.",
    "type": "object",
    "properties": {
        "subnetNum": {
            "description": "The number of the Network Subnet Component in the IP Address.\n\nE.g.,\n192.168.0.1\n        ^",
            "markdownDescription": "The number of the Network Subnet Component in the IP Address.\n\nE.g.,\n```\n192.168.0.1\n        ^\n```",
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 0
        },
        "mainRouter": {
            "description": "Configuration Properties associated with the Main Router the WDS Bridge is being established with.",
            "markdownDescription": "Configuration Properties associated with the *Main Router* the WDS Bridge is being established with.",
            "type": "object",
            "properties": {
                "ipNum": {
                    "description": "The number of the Device-Specific Component of the Main Router's IP Address.\n\nE.g.,\n192.168.0.1\n          ^",
                    "markdownDescription": "The number of the Device-Specific Component of the Main Router's IP Address.\n\nE.g.,\n```\n192.168.0.1\n          ^\n```",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "default": 1
                },
                "networkName": {
                    "description": "The SSID or Name of the Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                    "type": "string",
                    "minLength": 1
                },
                "networkPw": {
                    "description": "The Plaintext Password of the Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                    "type": "string"
                },
                "wifiNetworks": {
                    "description": "Configuration Options associated with the Wi-Fi Networks associated with the Main Router.",
                    "type": "object",
                    "properties": {
                        "2.4GHz": {
                            "description": "Configuration Options associated with the 2.4GHz Wi-Fi Network associated with the Main Router.",
                            "markdownDescription": "Configuration Options associated with the `2.4GHz` Wi-Fi Network associated with the Main Router.",
                            "type": "object",
                            "properties": {
                                "networkName": {
                                    "description": "The SSID or Name of the 2.4GHz Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "markdownDescription": "The SSID or Name of the `2.4GHz` Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "type": "string",
                                    "minLength": 1
                                },
                                "networkPw": {
                                    "description": "The Plaintext Password of the 2.4GHz Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "markdownDescription": "The Plaintext Password of the `2.4GHz` Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "type": "string"
                                }
                            },
                            "required": ["networkName"]
                        },
                        "5GHz": {
                            "description": "Configuration Options associated with the 5GHz Wi-Fi Network associated with the Main Router.",
                            "markdownDescription": "Configuration Options associated with the `5GHz` Wi-Fi Network associated with the Main Router.",
                            "type": "object",
                            "properties": {
                                "networkName": {
                                    "description": "The SSID or Name of the 5GHz Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "markdownDescription": "The SSID or Name of the `5GHz` Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "type": "string",
                                    "minLength": 1
                                },
                                "networkPw": {
                                    "description": "The Plaintext Password of the 5GHz Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "markdownDescription": "The Plaintext Password of the `5GHz` Wi-Fi Network of the Main Router that the WDS Bridge is to be connected to.",
                                    "type": "string"
                                },
                                "usesDfsChannels": {
                                    "description": "Indicates whether or not the Main Router utilizes DFS (Dynamic Frequency Selection) Channels for the 5GHz Wi-Fi Frequency.\n\nSome Bridge Routers and Reconnection Methods do not support using DFS Channels for the WDS Bridge, and this option will prevent such routers and methods from being used to re-establish the WDS Bridge on the 5GHz Wi-Fi Band.",
                                    "markdownDescription": "Indicates whether or not the Main Router utilizes *DFS (Dynamic Frequency Selection) Channels* for the `5GHz` Wi-Fi Frequency.\n\nSome Bridge Routers and Reconnection Methods do not support using DFS Channels for the WDS Bridge, and this option will prevent such routers and methods from being used to re-establish the WDS Bridge on the 5GHz Wi-Fi Band.",
                                    "type": "boolean"
                                }
                            },
                            "required": ["networkName"]
                        }
                    }
                }
            },
            "required": ["ipNum", "networkName", "wifiNetworks"]
        },
        "bridgeRouter": {
            "description": "Configuration Properties associated with the Bridge Router responsible for operating the WDS Bridge.",
            "markdownDescription": "Configuration Properties associated with the *Bridge Router* responsible for operating the WDS Bridge.",
            "type": "object",
            "properties": {
                "ipNum": {
                    "description": "The number of the Device-Specific Component of the Bridge Router's IP Address.\n\nE.g.,\n192.168.0.2\n          ^",
                    "markdownDescription": "The number of the Device-Specific Component of the Bridge Router's IP Address.\n\nE.g.,\n```\n192.168.0.2\n          ^\n```",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "default": 1
                },
                "managementPw": {
                    "description": "The plaintext password used to login to the Management Interface of the Bridge Router.",
                    "type": "string",
                    "minLength": 1
                },
                "model": {
                    "description": "The Model of the Bridge Router responsible for operating the WDS Bridge.\n\nThis value is used to determine which Reconnection Method(s) to use when establishing and/or re-establishing the WDS Bridge.",
                    "type": "string",
                    "enum": ["auto", "archer-c5-v4"],
                    "default": "auto"
                }
            },
            "required": ["ipNum", "managementPw"]
        },
        "bridgeFrequency": {
            "description": "The Wi-Fi Frequency the WDS Bridge should be established on.",
            "type": "string",
            "enum": ["2.4GHz", "5GHz"],
            "default": "5GHz"
        },
        "verificationInterval": {
            "description": "The amount of time to wait between attempts to verify the status of the WDS Bridge in milliseconds.\n\nCan be changed at runtime using Keyboard Shortcuts.",
            "markdownDescription": "The amount of time to wait between calls to `verifyBridgeStatus()` in **milliseconds**.\n\nCan be changed at runtime using *Keyboard Shortcuts*.",
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000,
            "default": 30000
        },
        "retries": {
            "description": "Configuration Properties associated with retrying attempts to re-establish the WDS Bridge after a failed attempt.",
            "markdownDescription": "Configuration Properties associated with retrying attempts to re-establish the WDS Bridge after a *failed attempt*.",
            "type": "object",
            "properties": {
                "minRetryTime": {
                    "description": "The minimum amount of time to wait in milliseconds before attempting to re-establish the WDS Bridge after the last failed attempt.",
                    "markdownDescription": "The *minimum* amount of time to wait in **milliseconds** before attempting to re-establish the WDS Bridge after the last failed attempt.",
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 120000,
                    "default": 5000
                },
                "maxRetryTime": {
                    "description": "The maximum amount of time to wait in milliseconds before attempting to re-establish the WDS Bridge after the last failed attempt.",
                    "markdownDescription": "The *maximum* amount of time to wait in **milliseconds** before attempting to re-establish the WDS Bridge after the last failed attempt.",
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 120000,
                    "default": 60000
                },
                "maxMethodRetries": {
                    "description": "The maximum number of attempts to re-restablish the WDS Bridge before attempting to switch Reconnection Methods.\n\nOnly applicable when `reconnectionMethod.method` is set to 'auto'.",
                    "markdownDescription": "The maximum number of attempts to re-restablish the WDS Bridge before attempting to switch *Reconnection Methods*.\n\nOnly applicable when `reconnectionMethod.method` is set to `'auto'`.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 3
                },
                "maxFailureRetries": {
                    "description": "The maximum number of attempts to re-restablish the WDS Bridge before giving up and terminating the program.",
                    "markdownDescription": "The maximum number of attempts to re-restablish the WDS Bridge before giving up and terminating the program.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 30
                }
            }
        },
        "reconnectionMethods": {
            "description": "Configuration Properties associated with the Reconnection Methods used to establish and/or re-establish the WDS Bridge.",
            "markdownDescription": "Configuration Properties associated with the *Reconnection Methods* used to establish and/or re-establish the WDS Bridge.",
            "type": "object",
            "properties": {
                "method": {
                    "description": "The name of the Reconnection Method to be used when re-establishing the WDS Bridge.\n\nThe available options are based on the specified Bridge Router Model.\n\nWhen set to 'auto', the Reconnection Method will be automatically selected from the Registered Reconnection Methods by the program and be permitted to switch between the available Reconnection Methods once the designated maximum number of retries has been reached.",
                    "markdownDescription": "The name of the *Reconnection Method* to be used when re-establishing the WDS Bridge.\n\nThe available options are based on the specified `bridgeRouter.model`.\n\nWhen set to `'auto'`, the Reconnection Method will be automatically selected from the *Registered Reconnection Methods* by the program and be permitted to switch between the available Reconnection Methods once the designated `retires.maxMethodRetries` has been reached.",
                    "type": "string",
                    "default": "auto"
                },
                "deferSetup": {
                    "description": "Defers performing the Setup Routine for each of the Registered Reconnection Methods until the Reconnection Method is invoked to re-establish the WDS Bridge.\n\nWhile this option will allow the program to startup faster, it may also prevent setup errors from being raised, and even the possibility of the program terminating, until an attempt is made to re-establish the WDS bridge using the Reconnection Method.",
                    "markdownDescription": "Defers performing the *Setup Routine* for each of the Registered Reconnection Methods until the Reconnection Method is *invoked* to re-establish the WDS Bridge.\n\nWhile this option will allow the program to startup faster, it may also prevent setup errors from being raised, and even the possibility of the program terminating, until an attempt is made to re-establish the WDS bridge using the Reconnection Method.",
                    "type": "boolean",
                    "default": "false"
                },
                "onlyRotateOnFailure": {
                    "description": "When the `method` option is set to 'auto', this option indicates that the Current Reconnection Method should only be rotated to an alternative Reconnection Method if the Current Reconnection Method fails to re-establish the WDS Bridge.\n\nWhen set to false, the Current Reconnection Method may be rotated in additional situations, including if the Current Reconnection Method does not support an optional feature that is being requested.",
                    "markdownDescription": "When the `method` option is set to `'auto'`, this option indicates that the Current Reconnection Method should only be rotated to an alternative Reconnection Method if the Current Reconnection Method fails to re-establish the WDS Bridge.\n\nWhen set to `false`, the Current Reconnection Method may be rotated in additional situations, including if the Current Reconnection Method does not support an optional feature that is being requested.",
                    "type": "boolean",
                    "default": "false"
                },
                "actionCooldown": {
                    "description": "Configuration Properties associated with the cooldown periods between individual actions taken by Reconnection Methods when re-establishing the WDS Bridge.\n\nEach property corresponds to a different type of Reconnection Method and is specified in milliseconds as a non-negative integer that is less than 10000.",
                    "markdownDescription": "Configuration Properties associated with the *cooldown periods* between individual actions taken by *Reconnection Methods* when re-establishing the WDS Bridge.\n\nEach property corresponds to a different `type` of *Reconnection Method* and is specified in **milliseconds** as a *non-negative `integer`* that is less than **10000**.",
                    "type": "object",
                    "properties": {
                        "puppeteer": {
                            "description": "The amount of time to wait between Puppeteer Actions in milliseconds.\n\nBecause this cooldown affects all Puppeteer operations, values above ~250ms are not recommended.",
                            "markdownDescription": "The amount of time to [wait between Puppeteer Actions](https://pptr.dev/api/puppeteer.connectoptions#slowmo) in **milliseconds**.\n\nBecause this cooldown affects *all* Puppeteer operations, values above `~250ms` are **not** recommended.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000,
                            "default": 100
                        },
                        "cgi": {
                            "description": "The amount of time to wait between HTTP Requests made to the Router Browser CGI in milliseconds.",
                            "markdownDescription": "The amount of time to wait between *HTTP Requests* made to the *Router Browser CGI* in **milliseconds**.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000,
                            "default": 1250
                        },
                        "other": {
                            "description": "The amount of time to wait between actions when using a Reconnection Method whose type is 'other' in milliseconds.\n\nBecause of the wide range of actions this cooldown may apply to and the potential consequences of long cooldowns for some Reconnection Methods, shorter values less than ~500ms are recommended.",
                            "markdownDescription": "The amount of time to wait between *actions* when using a *Reconnection Method* whose `type` is `'other'` in **milliseconds**.\n\nBecause of the wide range of actions this cooldown may apply to and the potential consequences of long cooldowns for some *Reconnection Methods*, shorter values less than `~500ms` are recommended.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000,
                            "default": 500
                        }
                    }
                },
                "bridgeFrequency": {
                    "description": "Configuration Properties associated with the Wi-Fi Frequency being used for the WDS Bridge.",
                    "type": "object",
                    "properties": {
                        "frequency": {
                            "description": "The Wi-Fi Frequency to use for the WDS Bridge.\n\nThe 'auto' and 'dynamic' options both select the most eligible Wi-Fi Frequency to use based on the Main Router, Bridge Router, and the available Reconnection Methods. However, the 'dynamic' option allows the Wi-Fi Frequency for the WDS Bridge to be changed at runtime while the 'auto' option does not.",
                            "markdownDescription": "The Wi-Fi Frequency to use for the WDS Bridge.\n\nThe `'auto'` and `'dynamic'` options both select the most eligible Wi-Fi Frequency to use based on the Main Router, Bridge Router, and the available Reconnection Methods. However, the `'dynamic'` option allows the Wi-Fi Frequency for the WDS Bridge to be changed at runtime while the `'auto'` option does not.",
                            "type": "string",
                            "default": "auto",
                            "enum": ["auto", "dynamic", "2.4GHz", "5GHz"]
                        }
                    }
                },


                /* Custom Configuration Properties */

                // archer-c5-v4/cgi
                "cgiEncryptedLoginCredentials": {
                    "description": "Defers performing the Setup Routine for each of the Registered Reconnection Methods until the Reconnection Method is invoked to re-establish the WDS Bridge.\n\nWhile this option will allow the program to startup faster, it may also prevent setup errors from being raised, and even the possibility of the program terminating, until an attempt is made to re-establish the WDS bridge using the Reconnection Method.",
                    "markdownDescription": "Defers performing the *Setup Routine* for each of the Registered Reconnection Methods until the Reconnection Method is *invoked* to re-establish the WDS Bridge.\n\nWhile this option will allow the program to startup faster, it may also prevent setup errors from being raised, and even the possibility of the program terminating, until an attempt is made to re-establish the WDS bridge using the Reconnection Method.",
                    "type": "object",
                    "properties": {
                        "username": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        }
                    },
                    "required": ["username", "password"]
                }
            }
        },
        "verboseLogging": {
            "description": "Configuration Properties associated with logging methods reserved for verbose logs.",
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Indicates whether additional, more verbose logging should be enabled by default or not.\n\nVerbose Logging can still be enabled and disabled at runtime using the 'v' Key.",
                    "markdownDescription": "Indicates whether additional, more verbose logging should be enabled by default or not.\n\n*Verbose Logging* can still be enabled and disabled at runtime using the `v` Key.",
                    "type": "boolean",
                    "default": false
                },
                "dataLoggingEnabled": {
                    "description": "Indicates whether additional, more verbose logging containing specific data, parameters, and return values should be enabled by default or not.\n\nVerbose Data Logging can still be enabled and disabled at runtime using the 'Shift + V' Key.",
                    "markdownDescription": "Indicates whether additional, more verbose logging containing specific data, parameters, and return values should be enabled by default or not.\n\n*Verbose Data Logging* can still be enabled and disabled at runtime using the `Shift + V` Key.",
                    "type": "boolean",
                    "default": false
                }
            }
        }
    },
    "required": ["subnetNum", "mainRouter", "bridgeRouter"],
    "allOf": [
        {
            "if": {
                "properties": {
                    "bridgeRouter": {
                        "properties": {
                            "model": {
                                "const": "auto"
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "reconnectionMethods": {
                        "properties": {
                            "method": {
                                "const": "auto"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "bridgeRouter": {
                        "properties": {
                            "model": {
                                "enum": ["archer-c5-v4"]
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "reconnectionMethods": {
                        "properties": {
                            "method": {
                                "enum": ["auto", "cgi", "puppeteer"]
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "reconnectionMethods": {
                        "properties": {
                            "bridgeFrequency": {
                                "properties": {
                                    "frequency": {
                                        "enum": ["2.4GHz", "5GHz"]
                                    }
                                },
                                "required": ["frequency"]
                            }
                        },
                        "required": ["bridgeFrequency"]
                    }
                },
                "required": ["reconnectionMethods"]
            },
            "then": {
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "reconnectionMethods": {
                                    "properties": {
                                        "bridgeFrequency": {
                                            "properties": {
                                                "frequency": {
                                                    "const": "2.4GHz"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "mainRouter": {
                                    "properties": {
                                        "wifiNetworks": {
                                            "required": ["2.4GHz"]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "reconnectionMethods": {
                                    "properties": {
                                        "bridgeFrequency": {
                                            "properties": {
                                                "frequency": {
                                                    "const": "5GHz"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "mainRouter": {
                                    "properties": {
                                        "wifiNetworks": {
                                            "required": ["5GHz"]
                                        }
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "reconnectionMethods": {
                        "properties": {
                            "bridgeFrequency": {
                                "properties": {
                                    "frequency": {
                                        "const": "dynamic"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "reconnectionMethods": {
                        "properties": {
                            "bridgeFrequency": {
                                "properties": {
                                    "preferredFrequency": {
                                        "description": "Specifies the Preferred Wi-Fi Frequency to use for the WDS Bridge.\n\nIf specified, the program will always attempt to use this Wi-Fi Frequency for the WDS Bridge wherever possible, re-establishing the WDS Bridge on the desired frequency if necessary.\n\nIf omitted, the program will not attempt to change the Wi-Fi Frequency used for the WDS Bridge unless the current frequency is unavailable.",
                                        "markdownDescription": "Specifies the Preferred Wi-Fi Frequency to use for the WDS Bridge.\n\nIf specified, the program will always attempt to use this Wi-Fi Frequency for the WDS Bridge wherever possible, re-establishing the WDS Bridge on the desired frequency if necessary.\n\nIf omitted, the program will not attempt to change the Wi-Fi Frequency used for the WDS Bridge unless the current frequency is unavailable.",
                                        "type": "string",
                                        "enum": ["2.4GHz", "5GHz"]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}