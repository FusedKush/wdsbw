{
    "compilerOptions": {
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "baseUrl": "./",
        "esModuleInterop": true,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strictNullChecks": true,
        "outDir": "./dist"
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "**/*.js",
        "**/node_modules",
        "**/.*/"
    ],
}